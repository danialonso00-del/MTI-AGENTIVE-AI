# MTI Agentive AI Studio — configuración. Copia a .env y NO lo publiques.
# En modo demo no se necesita ninguna variable: todo funciona con fixtures locales.
APP_MODE=demo
# Transporte Odoo: json2 (Odoo 19+) o rpc (Odoo 18 o anterior). Solo se usa en sandbox, desde servidor.
ODOO_TRANSPORT=json2
ODOO_BASE_URL=
ODOO_DATABASE=
ODOO_API_KEY=
# Proveedor LLM opcional. Sin él, las redacciones usan plantillas deterministas.
LLM_PROVIDER=
LLM_API_KEY=
# fixture | gmail | graph
EMAIL_PROVIDER=fixture
# Importante: no uses el prefijo VITE_ para secretos; Vite lo expondría en el navegador.
